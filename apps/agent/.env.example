# Cinechan Agent — Environment (local dev only)
#
# NOTE: With the Cloudflare Workers AI migration (ADR 0001), the agent no longer
# needs any external API keys in production. The Worker talks to Workers AI via
# the `AI` binding, which authenticates at the account level.
#
# These variables exist only for running the agent outside Cloudflare
# (e.g. `tsx watch src/server.ts` on your machine).

# LLM provider: workersai | openai | groq | ollama
LLM_PROVIDER=workersai

# Cloudflare Workers AI (OpenAI-compatible endpoint, for local dev only)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
WORKERS_AI_MODEL=@cf/openai/gpt-oss-20b

# Fallback providers (optional, not used by default)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=

# TTS
TTS_PROVIDER=workersai
TTS_VOICE=carina
TTS_LANGUAGE=es

# Server
PORT=3003
